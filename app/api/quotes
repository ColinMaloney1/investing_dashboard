import { NextResponse } from "next/server";

export const dynamic = "force-dynamic";

export async function GET(request: Request) {
  const { searchParams } = new URL(request.url);
  const symbolsParam = searchParams.get("symbols");

  if (!symbolsParam) {
    return NextResponse.json({ error: "Missing symbols" }, { status: 400 });
  }

  const apiKey = process.env.FINNHUB_API_KEY;

  if (!apiKey) {
    return NextResponse.json(
      { error: "Missing FINNHUB_API_KEY in Vercel environment variables" },
      { status: 500 }
    );
  }

  const symbols = symbolsParam
    .split(",")
    .map((s) => s.trim().toUpperCase())
    .filter(Boolean);

  try {
    const entries = await Promise.all(
      symbols.map(async (symbol) => {
        const res = await fetch(
          `https://finnhub.io/api/v1/quote?symbol=${encodeURIComponent(symbol)}&token=${encodeURIComponent(apiKey)}`,
          { cache: "no-store" }
        );

        if (!res.ok) {
          throw new Error(`Failed quote fetch for ${symbol}`);
        }

        const data = await res.json();

        return [
          symbol,
          {
            current: Number(data.c ?? 0),
            change: Number(data.d ?? 0),
            changePercent: Number(data.dp ?? 0),
            high: Number(data.h ?? 0),
            low: Number(data.l ?? 0),
            open: Number(data.o ?? 0),
            previousClose: Number(data.pc ?? 0),
            volume: Number(data.v ?? 0),
          },
        ];
      })
    );

    return NextResponse.json({
      quotes: Object.fromEntries(entries),
      updatedAt: new Date().toISOString(),
    });
  } catch (error) {
    return NextResponse.json(
      {
        error:
          error instanceof Error ? error.message : "Unknown quote fetch error",
      },
      { status: 500 }
    );
  }
}
